# CE BetterTrader PRO — configuración local y de producción
# Copia este archivo a .env para desarrollo. En Render, crea estas variables
# desde Dashboard > Environment; nunca subas .env al repositorio.

# --- Solana / Helius ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# --- Servidor ---
API_HOST=0.0.0.0
API_PORT=8000
# En producción bajo el mismo dominio puede ser la URL pública de Render.
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
CACHE_TTL=300

# --- Persistencia opcional (Supabase Free) ---
# Crea la tabla ejecutando supabase_schema.sql en Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso privado y pagos ---
# true en Render; false solo para desarrollo local.
ACCESS_CONTROL=false
# Wallets administradoras separadas por comas.
ADMIN_WALLETS=
# Wallet que recibe los pagos; no uses una seed/private key aquí.
MERCHANT_WALLET=
ACCESS_PRICE_SOL=0.1
ACCESS_DURATION_DAYS=30
DEMO_MODE=false
DEMO_WALLET=

# --- Seguridad ---
# La ejecución server-side con private keys permanece desactivada.
# Usa la firma directa de Phantom/Solflare cuando se implemente el flujo seguro.
ALLOW_SERVER_SIDE_TRADING=false
